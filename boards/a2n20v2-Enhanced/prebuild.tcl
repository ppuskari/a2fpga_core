# Gowin Enhanced prebuild: the authentic Apple SynthLAB piano samples
# are generated locally, not checked into Git. A missing/invalid ROM
# must fail BEFORE synthesis, rather than silently produce DOC silence.
set board_dir [file dirname [file normalize [info script]]]
set pcm_file [file join $board_dir hdl piano_multisustain.mem]
set extract_tool [file normalize [file join $board_dir .. .. tools extract_synthlab_piano.py]]

if {[auto_execok py] ne ""} {
    set python_cmd [list py -3]
} elseif {[auto_execok python3] ne ""} {
    set python_cmd [list python3]
} elseif {[auto_execok python] ne ""} {
    set python_cmd [list python]
} else {
    error "SynthLAB requires Python 3; run py -3 tools/extract_synthlab_piano.py --download from the repository root"
}

if {![file exists $extract_tool]} {
    error "SynthLAB extraction script missing: $extract_tool"
}

if {![file exists $pcm_file]} {
    puts "SynthLAB ROM missing: downloading/checking authentic SynthLAB disk..."
    set generate_cmd [concat $python_cmd [list $extract_tool --download --out $pcm_file]]
    if {[catch {exec {*}$generate_cmd} message]} {
        error "SynthLAB extract FAILED: $message; run py -3 tools/extract_synthlab_piano.py --disk <your-synthLAB.po> from the repository root"
    }
    puts $message
}

# Always validate 1408 words/5632 PCM bytes and FNV32=170BB8B3,
# including if the file was generated by an earlier local build.
set check_cmd [concat $python_cmd [list $extract_tool --check --out $pcm_file]]
if {[catch {exec {*}$check_cmd} message]} {
    error "SynthLAB ROM FAILED validation: $message; regenerate with py -3 tools/extract_synthlab_piano.py --download"
}
puts $message

# Original timestamp hook, unchanged in behavior.
set now [clock format [clock seconds] -format "%Y%m%d%H%M%S"]
set out_file [file join $board_dir hdl datetime.svh]
set fp [open $out_file "w"]
puts $fp "// Generated build timestamp"
puts $fp "`define BUILD_DATETIME \"$now\""
close $fp
